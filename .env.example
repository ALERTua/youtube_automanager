# The settings of YouTube AutoManager. Copy this file to .env next to compose.yaml.
# Each line shows the default value. Remove the "#" of a line to change its value.

# The key that encrypts the YouTube cookies in the database. The service cannot store the cookies without it.
# Make a key once and keep it: with another key, the service cannot read the stored cookies, and you upload them again.
# Make a key with: docker compose run --rm youtube-automanager python -c "from youtube_automanager.youtube.session import generate_key; print(generate_key())"
# To change the key, give the new key first and the old one after a comma, until the service saves the cookies again.
# COOKIES_KEY=

# The time zone of the schedule, for example Europe/Kyiv. The default schedule runs daily at 18:00 in this zone.
# TZ=UTC

# More detail in the log, for example each request of yt-dlp. Turn it on to find the cause of a problem.
# VERBOSE=False

# The database. The default is a SQLite file in the data folder. For PostgreSQL, give for example
# postgresql://user:password@host:5432/youtube_automanager
# DATABASE_URL=sqlite:////data/youtube_automanager.sqlite

# The file name of the SQLite database in the data folder. It counts only when DATABASE_URL is not set.
# DB_FILENAME=youtube_automanager.sqlite

# The folder of the yt-dlp releases that the updater installs. The service uses them before the copy of the image.
# YTDLP_DIR=/data/yt-dlp

# The longest time of one sync run in seconds. The service stops a run that takes longer.
# CHILD_TIMEOUT_S=3600

# The address and the port inside the container where the service listens. Change the port mapping in compose.yaml instead.
# HOST=0.0.0.0
# PORT=8080

# The data folder inside the container. The image sets it, and compose.yaml mounts ./data there. Do not change it.
# HOME=/data
