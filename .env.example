# database username table. purely cosmetic
USERNAME=username

# configs path inside the container. you shouldn't change this if you do not know what you are doing
HOME=/app/config

# Youtube Automanager YaML config filename @ HOME
CONFIG_FILENAME=youtube_automanager.yaml

# Youtube Automanager sqlite database filename @ HOME
DB_FILENAME=youtube_automanager.sqlite

# logging verbose output. True or False
VERBOSE=False

# The key that encrypts the stored YouTube cookies. Without it, the service cannot store the cookies.
# Make a key with: uv run python -c "from youtube_automanager.youtube.session import generate_key; print(generate_key())"
# To change the key, give the new key first and the old one after a comma until the next cookie save.
COOKIES_KEY=
