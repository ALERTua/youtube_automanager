#: youtube_automanager/web/ui/settings_page.py
#, python-brace-format
msgid "The session check failed. {reason}"
msgstr "Перевірка сесії не вдалася. {reason}"

#: youtube_automanager/web/ui/settings_page.py
#, python-brace-format
msgid "The session check failed: {cause}"
msgstr "Перевірка сесії не вдалася: {cause}"

#: youtube_automanager/web/ui/settings_draft.py
