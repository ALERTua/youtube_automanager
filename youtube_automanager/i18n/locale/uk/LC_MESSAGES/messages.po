#: youtube_automanager/web/ui/settings_page.py
msgid ""
"Use Firefox. Chrome and other Chromium browsers can give cookies that "
"stop to work a few hours after the export."
msgstr ""
"Використовуйте Firefox. Chrome та інші браузери на Chromium можуть дати "
