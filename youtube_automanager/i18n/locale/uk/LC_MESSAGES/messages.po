msgstr "До"

#: youtube_automanager/web/ui/dates.py
msgid "Today"
msgstr "Сьогодні"

#: youtube_automanager/web/ui/dashboard.py
#: youtube_automanager/web/ui/history_page.py
msgid "Trigger"
msgstr "Тип запуску"

#: youtube_automanager/web/ui/rule_editor.py
msgid "Undecided"
msgstr "Ще не ясно"

#: youtube_automanager/web/ui/common.py youtube_automanager/web/ui/dashboard.py
