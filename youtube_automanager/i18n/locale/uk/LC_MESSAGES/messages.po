#: youtube_automanager/web/ui/subscriptions_page.py
#, python-brace-format
msgid "The subscription did not change. {reason}"
msgstr "Підписка не змінилася. {reason}"

#: youtube_automanager/web/ui/subscriptions_page.py
msgid ""
"The subscriptions of the account from the last refresh, and each channel "
"that a rule reads. A click on the title of a channel opens the channel on"
" YouTube."
msgstr ""
"Підписки акаунта з останнього оновлення й кожен канал, який читає "
"правило. Клік по назві каналу відкриває канал на YouTube."

#: youtube_automanager/web/ui/rule_editor.py
#, python-brace-format
msgid "The table shows the newest {shown} of the {total} videos."
msgstr "Таблиця показує найновіші відео: {shown} із {total}."

#: youtube_automanager/web/ui/notifications_section.py
msgid "The target does not exist any more."
msgstr "Адресата більше немає."

#: youtube_automanager/web/ui/notifications_section.py
#, python-brace-format
msgid "The target {name} is deleted."
msgstr "Адресата {name} видалено."

#: youtube_automanager/web/ui/notifications_section.py
#, python-brace-format
msgid "The target {name} is saved."
msgstr "Адресата {name} збережено."

#: youtube_automanager/web/ui/notifications_section.py
#, python-brace-format
msgid ""
"The test notification to {name} failed. The log of the service names the "
"cause."
msgstr "Тестове сповіщення для {name} не вдалося. Причину називає журнал сервісу."

#: youtube_automanager/web/ui/notifications_section.py
#, python-brace-format
msgid "The test notification went to {name}."
msgstr "Сервіс надіслав тестове сповіщення до {name}."

#: youtube_automanager/web/ui/settings_page.py
#, python-brace-format
msgid ""
"The text holds no login cookie of {domain}. Export the cookies of "
"youtube.com while you are signed in to YouTube."
msgstr ""
"У тексті немає cookies входу для {domain}. Увійдіть у YouTube і тоді "
"експортуйте cookies youtube.com."

#: youtube_automanager/web/ui/settings_page.py
msgid "The text is empty. Upload the cookie file, or paste its text."
msgstr "Текст порожній. Завантажте файл cookies або вставте його текст."

#: youtube_automanager/web/ui/settings_page.py
#, python-brace-format
msgid "The text is not a Netscape cookie file: {cause}."
msgstr "Текст не є файлом cookies у форматі Netscape: {cause}."

#: youtube_automanager/web/ui/settings_page.py
#, python-brace-format
msgid ""
"The text lacks these login cookies of {domain}: {names}. Export the "
"cookies again while you are signed in to YouTube."
msgstr ""
"У тексті немає цих cookies входу для {domain}: {names}. Увійдіть у "
"YouTube і експортуйте cookies ще раз."

#. Translators: {cause} is the English cause from the service, for example the
#. error of uv.
#: youtube_automanager/web/ui/ytdlp_section.py
#, python-brace-format
msgid "The update failed: {cause}"
msgstr "Оновлення не вдалося: {cause}"

#: youtube_automanager/web/ui/rule_editor.py
msgid "The visual editor cannot show this condition. Edit it as JsonLogic."
msgstr "Візуальний редактор не може показати цю умову. Змініть її як JsonLogic."

#: youtube_automanager/web/ui/theme.py
msgid "Theme: as the system of the device. Click for the dark theme."
msgstr "Тема: як у системі пристрою. Натисніть для темної теми."

#: youtube_automanager/web/ui/theme.py
msgid "Theme: dark. Click for the light theme."
msgstr "Тема: темна. Натисніть для світлої теми."

#: youtube_automanager/web/ui/theme.py
msgid "Theme: light. Click for the theme of the system."
msgstr "Тема: світла. Натисніть для теми системи."

#: youtube_automanager/web/ui/settings_page.py
msgid ""
"Then restart the service. Keep the key: with another key, the service "
"cannot read the stored cookies, and you upload them again."
msgstr ""
"Потім перезапустіть сервіс. Збережіть ключ: з іншим ключем сервіс не "
"прочитає збережені cookies, і їх треба завантажити знову."

#: youtube_automanager/web/ui/history_page.py
msgid "This is not a date, so the filter does not use it."
msgstr "Цей текст не дата, тому фільтр його не використовує."

